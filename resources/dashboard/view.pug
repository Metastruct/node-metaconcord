doctype html
html(lang="en")
	head
		meta(charset="UTF-8")
		meta(name="viewport", content="width=device-width, initial-scale=1.0")
		title metaconcord
		link(rel="icon", href="/favicon.ico")
		link(rel="stylesheet", href="https://fonts.googleapis.com/css?family=Open+Sans:400,400i,600,700&display=swap")
		style
			include style.css
	body
		header.navbar
			a.brand(href=siteUrl, title="metastruct.net")
				img.logo(src="/dashboard/static/logo.svg", alt="Meta Construct")
			span.name metaconcord
			.user
				img.avatar(src=session.avatarUrl, alt="")
				span.login= session.login
				button.btn.small.danger#restart(title="Exits the process, relies on the container restart policy") Restart
				button.btn.small#logout Log out
		main.panes
			section.pane.terminal
				.pane-head
					span.title Output
					.tools
						select.select#level-filter
							option(value="0", selected) all levels
							option(value="20") debug+
							option(value="30") info+
							option(value="40") warn+
							option(value="50") error+
						input.input#text-filter(type="search", placeholder="filter text", spellcheck="false")
						button.btn.small#pause(title="Pause autoscroll") Pause
						button.btn.small#clear Clear
				.console
					.log#log(tabindex="0")
					form.input-bar#input-bar(autocomplete="off", data-state="connecting")
						button.mode#mode(type="button", data-mode="js", title="Click, or Tab on an empty line, to switch") REPL
						input#input(type="text", placeholder="MetaConcord.container.getServices()", spellcheck="false", autofocus)
			section.pane.config
				.pane-head
					span.title Config
					.tools
						span.hint changes apply after a restart
				.configs#configs
		script(src="/dashboard/static/app.js")
