{
	"$ref": "#/definitions/DeathRequest",
	"$schema": "http://json-schema.org/draft-07/schema#",
	"definitions": {
		"DeathRequest": {
			"additionalProperties": false,
			"properties": {
				"data": {
					"additionalProperties": false,
					"properties": {
						"message": {
							"description": "the vanilla death message, e.g. \"Nick was slain by Zombie\"",
							"maxLength": 256,
							"type": "string"
						},
						"player": {
							"additionalProperties": false,
							"properties": {
								"nick": {
									"type": "string"
								},
								"uuid": {
									"type": "string"
								}
							},
							"required": ["nick", "uuid"],
							"type": "object"
						}
					},
					"required": ["player", "message"],
					"type": "object"
				},
				"name": {
					"const": "DeathPayload",
					"type": "string"
				}
			},
			"required": ["data", "name"],
			"type": "object"
		}
	}
}
