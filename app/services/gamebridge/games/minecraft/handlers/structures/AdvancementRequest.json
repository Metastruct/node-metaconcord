{
	"$ref": "#/definitions/AdvancementRequest",
	"$schema": "http://json-schema.org/draft-07/schema#",
	"definitions": {
		"AdvancementRequest": {
			"additionalProperties": false,
			"properties": {
				"data": {
					"additionalProperties": false,
					"properties": {
						"description": {
							"maxLength": 1000,
							"type": "string"
						},
						"player": {
							"additionalProperties": false,
							"properties": {
								"nick": {
									"type": "string"
								},
								"uuid": {
									"type": "string"
								}
							},
							"required": ["nick", "uuid"],
							"type": "object"
						},
						"title": {
							"maxLength": 256,
							"type": "string"
						},
						"type": {
							"description": "the advancement's frame type",
							"enum": ["task", "goal", "challenge"],
							"type": "string"
						}
					},
					"required": ["player", "title", "description", "type"],
					"type": "object"
				},
				"name": {
					"const": "AdvancementPayload",
					"type": "string"
				}
			},
			"required": ["data", "name"],
			"type": "object"
		}
	}
}
