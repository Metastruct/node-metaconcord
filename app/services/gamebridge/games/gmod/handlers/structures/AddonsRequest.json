{
	"$ref": "#/definitions/AddonsRequest",
	"$schema": "http://json-schema.org/draft-07/schema#",
	"definitions": {
		"AddonsRequest": {
			"additionalProperties": false,
			"description": "gmod cannot enumerate its own addons, so it only signals that it is ready to be pulled over SSH.",
			"properties": {
				"data": {
					"additionalProperties": false,
					"properties": {
						"games": {
							"description": "Game content the server has mounted, reported on every connect.",
							"items": {
								"additionalProperties": false,
								"properties": {
									"depot": {
										"description": "The steam app id.",
										"type": "number"
									},
									"folder": {
										"type": "string"
									},
									"title": {
										"description": "Absent when the engine has no name for it; the folder is the fallback.",
										"type": "string"
									}
								},
								"required": ["folder"],
								"type": "object"
							},
							"type": "array"
						},
						"pull": {
							"type": "boolean"
						}
					},
					"required": ["pull"],
					"type": "object"
				},
				"name": {
					"const": "AddonsPayload",
					"type": "string"
				}
			},
			"required": ["data", "name"],
			"type": "object"
		}
	}
}
