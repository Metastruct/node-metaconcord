{
	"$ref": "#/definitions/ConsoleRequest",
	"$schema": "http://json-schema.org/draft-07/schema#",
	"definitions": {
		"ConsoleRequest": {
			"additionalProperties": false,
			"properties": {
				"data": {
					"additionalProperties": false,
					"properties": {
						"lines": {
							"items": {
								"additionalProperties": false,
								"properties": {
									"color": {
										"description": "\"rrggbb\" when the whole line is one colour, absent when it is the default",
										"type": "string"
									},
									"level": {
										"type": "string"
									},
									"parts": {
										"description": "MsgC emits one chunk per colour, so a tagged line arrives in pieces. Present only when those pieces differ, in which case `color` is unset.",
										"items": {
											"additionalProperties": false,
											"properties": {
												"color": {
													"type": "string"
												},
												"text": {
													"type": "string"
												}
											},
											"required": ["text"],
											"type": "object"
										},
										"type": "array"
									},
									"text": {
										"description": "the whole line, plain, for filtering and search",
										"type": "string"
									}
								},
								"required": ["level", "text"],
								"type": "object"
							},
							"type": "array"
						},
						"replay": {
							"description": "the backlog sent right after a subscribe, not live output",
							"type": "boolean"
						}
					},
					"required": ["lines"],
					"type": "object"
				},
				"name": {
					"const": "ConsolePayload",
					"type": "string"
				}
			},
			"required": ["data", "name"],
			"type": "object"
		}
	}
}
