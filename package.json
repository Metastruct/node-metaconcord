{
	"name": "metaconcord",
	"version": "0.0.1",
	"private": true,
	"description": "metaluvit but typescript",
	"license": "MIT",
	"repository": "git@github.com:metastruct/metaconcord",
	"author": "marceau-maubert <marceau.maubert2@gmail.com>",
	"type": "module",
	"imports": {
		"#config/*": "./config/*",
		"#utils": "./utils.js",
		"#polyfills/*": {
			"@metaconcord/ts-import": "./polyfills/*.ts",
			"default": "./polyfills/*.js"
		},
		"#/app/*": "./app/*",
		"#/generated/*": "./generated/*",
		"#extensions/*": "./extensions/*",
		"#lib/*": {
			"@metaconcord/ts-import": "./lib/*.ts",
			"default": "./lib/*.js"
		}
	},
	"sideEffects": true,
	"engines": {
		"node": ">=26.0.0"
	},
	"scripts": {
		"build": "run-s generate compile",
		"check": "run-s generate:db-types check:typescript check:eslint",
		"check:eslint": "eslint",
		"check:typescript": "tsc --noEmit",
		"ci:lint": "cross-env SARIF_ESLINT_IGNORE_SUPPRESSED=true eslint --format @microsoft/eslint-formatter-sarif --output-file eslint-results.sarif",
		"clean": "rimraf ./dist",
		"compile": "tsc",
		"dev": "cross-env NODE_ENV=development DEBUG=express:*,router,router:* node --enable-source-maps dist",
		"dev:disable-git-hooks": "git config --unset core.hooksPath",
		"dev:enable-git-hooks": "git config core.hooksPath .githooks",
		"dev:web": "cross-env METACONCORD_SERVICES=infra,web NODE_ENV=development DEBUG=express:*,router,router:* node --enable-source-maps dist",
		"fluxer:mirror": "node scripts/fluxer-mirror.js",
		"fluxer:mirror-expressions": "node scripts/fluxer-mirror-expressions.js",
		"generate": "run-p generate:*",
		"generate:db-types": "node --conditions=@metaconcord/ts-import scripts/generate-db-types.ts",
		"generate:schema": "node schema_gen.js",
		"generate:scss": "sass resources/ --no-source-map",
		"lint": "eslint",
		"lint:fix": "eslint --fix",
		"pretest": "run-s build",
		"rebuild": "run-s clean build",
		"scss-watch": "sass --watch resources/ --no-source-map",
		"start": "node --enable-source-maps dist",
		"test": "run-s test:* test:dist:*",
		"test:dist:fluxer": "node --test --enable-source-maps test/fluxer-formatting-dist.test.js",
		"test:dist:markov": "node --experimental-test-module-mocks --test --enable-source-maps dist/test/markov.test.js",
		"test:dist:oidc": "cross-env NODE_ENV=development node --test --enable-source-maps dist/test/oidc.test.js",
		"test:dist:superreplacer": "node --test --enable-source-maps dist/test/super-replacer.test.js",
		"test:fluxer": "node --test test/fluxer-mappings.test.js",
		"test:polyfills": "node --conditions=@metaconcord/ts-import --test test/iterator-zip.test.ts"
	},
	"dependencies": {
		"@gitbeaker/rest": "^43.8.0",
		"@microsoft/signalr": "^10.0.11",
		"@napi-rs/canvas": "^1.1.0",
		"@octokit/auth-app": "^8.3.1",
		"@octokit/rest": "^22.0.1",
		"@octokit/webhooks": "^14.2.0",
		"@resvg/resvg-js": "^2.6.2",
		"ajv": "^8.20.0",
		"axios": "^1.21.0",
		"better-sqlite3": "^13.0.3",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dayjs": "^1.11.23",
		"diff": "^9.0.0",
		"discord-interactions": "^4.4.0",
		"discord.js": "^14.28.1",
		"dotenv": "^18.0.9",
		"express": "^5.3.0",
		"express-rate-limit": "^8.7.3",
		"form-data": "^4.0.6",
		"graphql": "^16",
		"graphql-request": "^7.4.0",
		"irc-upd": "^0.11.0",
		"jsonwebtoken": "^9.0.3",
		"kysely": "^0.29.8",
		"mime": "^4.1.2",
		"mnemonist": "^0.40.7",
		"node-schedule": "^2.1.2",
		"npm-run-all2": "^9.0.4",
		"oidc-provider": "^9.13.3",
		"pg": "^8.23.1",
		"pino": "^10.4.0",
		"pino-http": "^11.0.0",
		"pug": "^3.0.4",
		"qs": "^6.17.1",
		"steamid": "^2.1.0",
		"unicode-emoji-json": "^0.9.0",
		"vrchat": "^2.26.0",
		"websocket": "^1.0.35"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@microsoft/eslint-formatter-sarif": "^3.1.0",
		"@microsoft/sarif": "^5.8.0",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@tsconfig/node26": "^26.0.1",
		"@tsconfig/strictest": "^2.0.8",
		"@types/better-sqlite3": "^9.6.0",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^26.6.6",
		"@types/node-schedule": "^2.1.8",
		"@types/oidc-provider": "^9",
		"@types/pg": "^8.23.1",
		"@types/pug": "^2.0.10",
		"@types/steamid": "^2.0.4",
		"@types/websocket": "^1.0.10",
		"cross-env": "^10.1.0",
		"eslint": "^10.14.0",
		"eslint-package-json": "^3.0.0",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"eslint-plugin-unicorn": "^79.0.0",
		"globals": "^17.14.0",
		"kysely-typegen": "^2.1.0",
		"rimraf": "^6.1.4",
		"safe-stable-stringify": "^3.0.0",
		"sass": "^1.108.0",
		"ts-json-schema-generator": "^2.9.0",
		"typescript": "^6",
		"typescript-eslint": "^8.72.1"
	}
}
