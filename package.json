{
	"name": "metaconcord",
	"version": "0.0.1",
	"private": true,
	"description": "metaluvit but typescript",
	"license": "MIT",
	"repository": "git@github.com:metastruct/metaconcord",
	"author": "marceau-maubert <marceau.maubert2@gmail.com>",
	"type": "module",
	"imports": {
		"#config/*": "./config/*",
		"#utils": "./utils.ts",
		"#polyfills/*": "./polyfills/*.ts",
		"#/*": "./*",
		"#jtd/*": "./types/*.jtd.ts",
		"#lib/*": "./lib/*.ts"
	},
	"sideEffects": true,
	"engines": {
		"node": ">=26.0.0"
	},
	"scripts": {
		"build": "run-s generate compile",
		"check": "run-s generate:db-types check:typescript check:eslint",
		"check:eslint": "eslint",
		"check:typescript": "tsc --noEmit",
		"ci:lint": "cross-env SARIF_ESLINT_IGNORE_SUPPRESSED=true eslint --format @microsoft/eslint-formatter-sarif --output-file eslint-results.sarif",
		"clean": "run-p clean:*",
		"clean:generated": "rimraf ./dist ./generated",
		"clean:pack": "rimraf --glob ./metaconcord-*.tgz",
		"compile": "tsc",
		"dev": "cross-env NODE_ENV=development DEBUG=express:*,router,router:* node index.ts",
		"dev:disable-git-hooks": "git config --unset core.hooksPath",
		"dev:enable-git-hooks": "git config core.hooksPath .githooks",
		"dev:web": "cross-env METACONCORD_SERVICES=infra,web NODE_ENV=development DEBUG=express:*,router,router:* node index.ts",
		"fluxer:mirror": "node scripts/fluxer-mirror.ts",
		"fluxer:mirror-expressions": "node scripts/fluxer-mirror-expressions.ts",
		"generate": "run-p generate:*",
		"generate:db-types": "node scripts/generate-db-types.ts",
		"generate:schema": "node scripts/generate-schema.js",
		"generate:scss": "sass resources/ --no-source-map",
		"lint": "eslint",
		"lint:fix": "eslint --fix",
		"migrate:down": "node scripts/migrate.ts up",
		"migrate:help": "node scripts/migrate.ts help",
		"migrate:latest": "node scripts/migrate.ts up",
		"migrate:make": "node scripts/migrate.ts make",
		"migrate:up": "node scripts/migrate.ts up",
		"prepack": "run-s rebuild",
		"pretest": "run-s build",
		"rebuild": "run-s clean build",
		"scss-watch": "sass --watch resources/ --no-source-map",
		"start": "node index.ts",
		"test": "run-s test:*",
		"test:fluxer-formatting": "node --test test/fluxer-formatting.test.js",
		"test:fluxer-mappings": "node --test test/fluxer-mappings.test.js",
		"test:markov": "node --experimental-test-module-mocks --test test/markov.test.ts",
		"test:oidc": "node --test test/oidc.test.ts",
		"test:polyfills": "node --test test/iterator-zip.test.ts",
		"test:superreplacer": "node --test test/super-replacer.test.ts"
	},
	"files": [
		"./*.json",
		"./*.ts",
		"./app",
		"./config/*.example.json",
		"./extensions",
		"./lib",
		"./migrations",
		"./polyfills",
		"./resources",
		"./schemas",
		"./test",
		"./types"
	],
	"dependencies": {
		"@gitbeaker/rest": "^44.1.10",
		"@microsoft/signalr": "^11.0.0",
		"@napi-rs/canvas": "^1.2.1",
		"@octokit/auth-app": "^8.3.1",
		"@octokit/rest": "^22.0.1",
		"@octokit/webhooks": "^14.2.0",
		"@resvg/resvg-js": "^2.6.2",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"axios": "^1.21.1",
		"better-sqlite3": "^13.2.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dayjs": "^1.11.23",
		"diff": "^9.0.0",
		"discord-interactions": "^4.4.0",
		"discord.js": "^14.28.1",
		"dotenv": "^18.0.10",
		"express": "^5.3.0",
		"express-rate-limit": "^8.7.5",
		"form-data": "^4.0.6",
		"graphql": "^16",
		"graphql-request": "^7.4.0",
		"jsonwebtoken": "^9.0.3",
		"kysely": "^0.29.9",
		"mime": "^4.1.2",
		"mnemonist": "^0.40.8",
		"node-schedule": "^2.1.2",
		"npm-run-all2": "^9.1.0",
		"oidc-provider": "^9.15.1",
		"pg": "^8.23.1",
		"pino": "^10.4.0",
		"pino-http": "^11.0.0",
		"pug": "^3.0.4",
		"qs": "^6.17.1",
		"steamid": "^2.1.0",
		"unicode-emoji-json": "^0.9.0",
		"vrchat": "^2.26.0",
		"websocket": "^1.0.35"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@microsoft/eslint-formatter-sarif": "^3.1.0",
		"@microsoft/sarif": "^5.9.0",
		"@stylistic/eslint-plugin": "^6.0.1",
		"@tsconfig/node26": "^26.0.2",
		"@tsconfig/strictest": "^2.0.9",
		"@types/better-sqlite3": "^9.6.0",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^26.6.11",
		"@types/node-schedule": "^2.1.8",
		"@types/oidc-provider": "^9",
		"@types/pg": "^8.23.1",
		"@types/pug": "^2.0.10",
		"@types/steamid": "^2.0.4",
		"@types/websocket": "^1.0.10",
		"cross-env": "^10.1.0",
		"eslint": "^10.15.0",
		"eslint-package-json": "^3.0.0",
		"eslint-plugin-import-x": "https://pkg.pr.new/eslint-plugin-import-x@0ec4d59",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"eslint-plugin-unicorn": "^80.0.0",
		"globals": "^17.14.0",
		"kysely-typegen": "^2.1.0",
		"rimraf": "^6.1.4",
		"safe-stable-stringify": "^3.0.1",
		"sass": "^1.108.2",
		"ts-json-schema-generator": "^2.10.0",
		"typescript": "^6",
		"typescript-eslint": "^8.74.0"
	}
}
