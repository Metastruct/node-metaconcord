{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Metastruct/node-metaconcord/refs/heads/master/schemas/jwks.schema.json",
  "title": "Private JSON Web Key Set",
  "description": "A private asymmetric JWK Set profile based on RFC 7517, RFC 7518, and RFC 8037. Supports RSA, P-256/P-384/P-521 EC keys, and Ed25519/Ed448/X25519/X448 OKP keys. Each key includes public and private components. RSA CRT parameters are required by this profile.",
  "$comment": "This profile restricts key types, curves, algorithms, uses, and operations. Additional properties are allowed for extensibility.",
  "type": "object",
  "properties": {
    "keys": {
      "type": "array",
      "description": "Private asymmetric JWKs. An empty array is permitted. Array order does not imply preference unless the application assigns it meaning.",
      "items": {
        "$ref": "#/$defs/jwk"
      }
    }
  },
  "required": ["keys"],
  "additionalProperties": true,
  "$defs": {
    "base64url": {
      "type": "string",
      "minLength": 2,
      "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-][AQgw]|[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048])?$(?![\\s\\S])",
      "description": "Canonical nonempty unpadded base64url encoding, without whitespace and with zero unused pad bits."
    },
    "positiveBase64urlUInt": {
      "type": "string",
      "allOf": [
        {
          "$ref": "#/$defs/base64url"
        },
        {
          "type": "string",
          "not": {
            "type": "string",
            "pattern": "^A[A-P]"
          }
        }
      ],
      "description": "A strictly positive integer in minimal unsigned big-endian Base64urlUInt representation, without leading zero octets. Excludes the zero value permitted by the general RFC 7518 Base64urlUInt definition."
    },
    "octets20": {
      "type": "string",
      "$ref": "#/$defs/base64url",
      "minLength": 27,
      "maxLength": 27,
      "description": "Canonical unpadded base64url encoding of exactly 20 octets."
    },
    "octets32": {
      "type": "string",
      "$ref": "#/$defs/base64url",
      "minLength": 43,
      "maxLength": 43,
      "description": "Canonical unpadded base64url encoding of exactly 32 octets."
    },
    "octets48": {
      "type": "string",
      "$ref": "#/$defs/base64url",
      "minLength": 64,
      "maxLength": 64,
      "description": "Canonical unpadded base64url encoding of exactly 48 octets."
    },
    "octets56": {
      "type": "string",
      "$ref": "#/$defs/base64url",
      "minLength": 75,
      "maxLength": 75,
      "description": "Canonical unpadded base64url encoding of exactly 56 octets."
    },
    "octets57": {
      "type": "string",
      "$ref": "#/$defs/base64url",
      "minLength": 76,
      "maxLength": 76,
      "description": "Canonical unpadded base64url encoding of exactly 57 octets."
    },
    "octets66": {
      "type": "string",
      "$ref": "#/$defs/base64url",
      "minLength": 88,
      "maxLength": 88,
      "description": "Canonical unpadded base64url encoding of exactly 66 octets."
    },
    "base64Certificate": {
      "type": "string",
      "minLength": 4,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/][AQgw]==|[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=)?$(?![\\s\\S])",
      "description": "DER-encoded X.509 certificate represented as canonical standard base64, not base64url, with padding when needed and no whitespace."
    },
    "signingMetadata": {
      "type": "object",
      "description": "Optional signature metadata: use is sig, and key_ops contains only sign and verify.",
      "properties": {
        "use": {
          "type": "string",
          "const": "sig"
        },
        "key_ops": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["sign", "verify"]
          }
        }
      }
    },
    "agreementMetadata": {
      "type": "object",
      "description": "Optional key-agreement metadata: use is enc, and key_ops contains only deriveKey and deriveBits. These operations apply to the asymmetric key, not to any subsequently derived symmetric key.",
      "properties": {
        "use": {
          "type": "string",
          "const": "enc"
        },
        "key_ops": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["deriveKey", "deriveBits"]
          }
        }
      }
    },
    "rsaEncryptionMetadata": {
      "type": "object",
      "description": "Optional RSA encryption metadata: use is enc, and key_ops contains only encrypt, decrypt, wrapKey, and unwrapKey.",
      "properties": {
        "use": {
          "type": "string",
          "const": "enc"
        },
        "key_ops": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["encrypt", "decrypt", "wrapKey", "unwrapKey"]
          }
        }
      }
    },
    "jwk": {
      "type": "object",
      "description": "A private asymmetric JWK containing both public and private key components.",
      "properties": {
        "kty": {
          "type": "string",
          "enum": ["RSA", "EC", "OKP"],
          "description": "Case-sensitive key type."
        },
        "use": {
          "type": "string",
          "enum": ["sig", "enc"],
          "description": "Optional intended public-key use: sig for signatures or enc for encryption, including key wrapping and key agreement. RFC 7517 discourages using use together with key_ops; when both are present, their meanings must be consistent."
        },
        "key_ops": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "sign",
              "verify",
              "encrypt",
              "decrypt",
              "wrapKey",
              "unwrapKey",
              "deriveKey",
              "deriveBits"
            ]
          },
          "description": "Optional intended operations, without duplicates. Related public- and private-component operations may be listed together. RFC 7517 discourages unrelated operation combinations and explicitly permits sign/verify, encrypt/decrypt, and wrapKey/unwrapKey pairs. It also discourages using key_ops together with use; when both are present, their meanings must be consistent."
        },
        "alg": {
          "type": "string",
          "description": "Optional intended algorithm, restricted by key type and curve."
        },
        "kid": {
          "type": "string",
          "description": "Optional case-sensitive key identifier with application-defined structure. Different keys in a JWK Set should normally have distinct identifiers, with exceptions permitted by RFC 7517."
        },
        "x5u": {
          "type": "string",
          "format": "uri",
          "description": "URI identifying a PEM-encoded X.509 certificate or certificate chain. The first certificate's public key must match the JWK, and related JWK metadata must be semantically consistent with that certificate. Retrieval requires integrity protection; HTTP GET retrieval requires TLS with server identity validation."
        },
        "x5c": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/base64Certificate"
          },
          "description": "Nonempty array of standard-base64-encoded DER X.509 certificates. The first certificate's public key must match the JWK; each subsequent certificate certifies the preceding certificate. Related JWK metadata must be semantically consistent with the first certificate."
        },
        "x5t": {
          "$ref": "#/$defs/octets20",
          "description": "Unpadded base64url-encoded SHA-1 digest of a DER-encoded X.509 certificate whose public key matches the JWK. Related JWK metadata must be semantically consistent with the certificate. This is a certificate thumbprint, not an RFC 7638 JWK thumbprint."
        },
        "x5t#S256": {
          "$ref": "#/$defs/octets32",
          "description": "Unpadded base64url-encoded SHA-256 digest of a DER-encoded X.509 certificate whose public key matches the JWK. Related JWK metadata must be semantically consistent with the certificate. This is a certificate thumbprint, not an RFC 7638 JWK thumbprint."
        }
      },
      "required": ["kty"],
      "oneOf": [
        {
          "$ref": "#/$defs/rsaPrivateKey"
        },
        {
          "$ref": "#/$defs/ecPrivateKey"
        },
        {
          "$ref": "#/$defs/okpPrivateKey"
        }
      ],
      "allOf": [
        {
          "type": "object",
          "if": {
            "type": "object",
            "properties": {
              "use": {
                "type": "string",
                "const": "sig"
              }
            },
            "required": ["use"]
          },
          "then": {
            "$ref": "#/$defs/signingMetadata"
          }
        },
        {
          "type": "object",
          "if": {
            "type": "object",
            "properties": {
              "use": {
                "type": "string",
                "const": "enc"
              }
            },
            "required": ["use"]
          },
          "then": {
            "type": "object",
            "properties": {
              "key_ops": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "encrypt",
                    "decrypt",
                    "wrapKey",
                    "unwrapKey",
                    "deriveKey",
                    "deriveBits"
                  ]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "if": {
            "type": "object",
            "properties": {
              "alg": {
                "type": "string",
                "enum": [
                  "RS256",
                  "RS384",
                  "RS512",
                  "PS256",
                  "PS384",
                  "PS512",
                  "ES256",
                  "ES384",
                  "ES512",
                  "EdDSA"
                ]
              }
            },
            "required": ["alg"]
          },
          "then": {
            "$ref": "#/$defs/signingMetadata"
          }
        },
        {
          "type": "object",
          "if": {
            "type": "object",
            "properties": {
              "alg": {
                "type": "string",
                "enum": [
                  "ECDH-ES",
                  "ECDH-ES+A128KW",
                  "ECDH-ES+A192KW",
                  "ECDH-ES+A256KW"
                ]
              }
            },
            "required": ["alg"]
          },
          "then": {
            "$ref": "#/$defs/agreementMetadata"
          }
        },
        {
          "type": "object",
          "if": {
            "type": "object",
            "properties": {
              "alg": {
                "type": "string",
                "enum": ["RSA-OAEP", "RSA-OAEP-256"]
              }
            },
            "required": ["alg"]
          },
          "then": {
            "$ref": "#/$defs/rsaEncryptionMetadata"
          }
        }
      ],
      "additionalProperties": true
    },
    "rsaPrivateKey": {
      "type": "object",
      "description": "RSA private JWK including public components. This profile requires all first- and second-factor CRT parameters, which is stricter than RFC 7518. The RSA algorithms allowed by this profile require a modulus of at least 2048 significant bits.",
      "properties": {
        "kty": {
          "type": "string",
          "const": "RSA"
        },
        "n": {
          "$ref": "#/$defs/positiveBase64urlUInt",
          "description": "RSA modulus."
        },
        "e": {
          "$ref": "#/$defs/positiveBase64urlUInt",
          "description": "RSA public exponent."
        },
        "d": {
          "$ref": "#/$defs/positiveBase64urlUInt",
          "description": "RSA private exponent."
        },
        "p": {
          "$ref": "#/$defs/positiveBase64urlUInt",
          "description": "First prime factor."
        },
        "q": {
          "$ref": "#/$defs/positiveBase64urlUInt",
          "description": "Second prime factor."
        },
        "dp": {
          "$ref": "#/$defs/positiveBase64urlUInt",
          "description": "First-factor CRT exponent, d mod (p - 1)."
        },
        "dq": {
          "$ref": "#/$defs/positiveBase64urlUInt",
          "description": "Second-factor CRT exponent, d mod (q - 1)."
        },
        "qi": {
          "$ref": "#/$defs/positiveBase64urlUInt",
          "description": "First CRT coefficient, the multiplicative inverse of q modulo p."
        },
        "oth": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rsaOtherPrime"
          },
          "description": "Additional prime information for multi-prime RSA, ordered consistently with the CRT representation. Contains one entry for each prime after p and q. Must be omitted for two-prime RSA."
        },
        "alg": {
          "type": "string",
          "enum": [
            "RS256",
            "RS384",
            "RS512",
            "PS256",
            "PS384",
            "PS512",
            "RSA-OAEP",
            "RSA-OAEP-256"
          ],
          "description": "Optional intended RSA algorithm, restricted to this profile's allowlist."
        },
        "key_ops": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "sign",
              "verify",
              "encrypt",
              "decrypt",
              "wrapKey",
              "unwrapKey"
            ]
          },
          "description": "Optional intended RSA operations."
        }
      },
      "required": ["kty", "n", "e", "d", "p", "q", "dp", "dq", "qi"],
      "additionalProperties": true
    },
    "rsaOtherPrime": {
      "type": "object",
      "description": "CRT information for an additional RSA prime factor after p and q.",
      "properties": {
        "r": {
          "$ref": "#/$defs/positiveBase64urlUInt",
          "description": "Additional prime factor."
        },
        "d": {
          "$ref": "#/$defs/positiveBase64urlUInt",
          "description": "CRT exponent for this factor, equal to the RSA private exponent mod (r - 1)."
        },
        "t": {
          "$ref": "#/$defs/positiveBase64urlUInt",
          "description": "CRT coefficient: the multiplicative inverse, modulo r, of the product of all preceding prime factors, including p and q."
        }
      },
      "required": ["r", "d", "t"],
      "additionalProperties": true
    },
    "ecPrivateKey": {
      "type": "object",
      "description": "RFC 7518 EC private JWK. Coordinates and private scalars use fixed-width big-endian octet strings, preserving leading zero octets: 32 octets for P-256, 48 for P-384, and 66 for P-521.",
      "properties": {
        "kty": {
          "type": "string",
          "const": "EC"
        },
        "crv": {
          "type": "string",
          "enum": ["P-256", "P-384", "P-521"],
          "description": "Case-sensitive curve identifier."
        },
        "x": {
          "$ref": "#/$defs/base64url",
          "description": "Public point's x-coordinate as a base64url-encoded fixed-width big-endian octet string."
        },
        "y": {
          "$ref": "#/$defs/base64url",
          "description": "Public point's y-coordinate as a base64url-encoded fixed-width big-endian octet string."
        },
        "d": {
          "$ref": "#/$defs/base64url",
          "description": "Private scalar as a base64url-encoded fixed-width big-endian octet string of the size required by the curve order."
        },
        "key_ops": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["sign", "verify", "deriveKey", "deriveBits"]
          },
          "description": "Optional intended EC operations."
        }
      },
      "required": ["kty", "crv", "x", "y", "d"],
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "crv": {
              "type": "string",
              "const": "P-256"
            },
            "x": {
              "$ref": "#/$defs/octets32"
            },
            "y": {
              "$ref": "#/$defs/octets32"
            },
            "d": {
              "$ref": "#/$defs/octets32"
            },
            "alg": {
              "type": "string",
              "enum": [
                "ES256",
                "ECDH-ES",
                "ECDH-ES+A128KW",
                "ECDH-ES+A192KW",
                "ECDH-ES+A256KW"
              ]
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "crv": {
              "type": "string",
              "const": "P-384"
            },
            "x": {
              "$ref": "#/$defs/octets48"
            },
            "y": {
              "$ref": "#/$defs/octets48"
            },
            "d": {
              "$ref": "#/$defs/octets48"
            },
            "alg": {
              "type": "string",
              "enum": [
                "ES384",
                "ECDH-ES",
                "ECDH-ES+A128KW",
                "ECDH-ES+A192KW",
                "ECDH-ES+A256KW"
              ]
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "crv": {
              "type": "string",
              "const": "P-521"
            },
            "x": {
              "$ref": "#/$defs/octets66"
            },
            "y": {
              "$ref": "#/$defs/octets66"
            },
            "d": {
              "$ref": "#/$defs/octets66"
            },
            "alg": {
              "type": "string",
              "enum": [
                "ES512",
                "ECDH-ES",
                "ECDH-ES+A128KW",
                "ECDH-ES+A192KW",
                "ECDH-ES+A256KW"
              ]
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "okpPrivateKey": {
      "type": "object",
      "description": "RFC 8037 Octet Key Pair private JWK. The x member contains the complete subtype-specific public-key octet string, not a generic affine x-coordinate. Ed25519 and Ed448 are signature subtypes; X25519 and X448 are key-agreement subtypes.",
      "properties": {
        "kty": {
          "type": "string",
          "const": "OKP"
        },
        "crv": {
          "type": "string",
          "enum": ["Ed25519", "Ed448", "X25519", "X448"],
          "description": "Case-sensitive key subtype, determining the key encodings, lengths, and algorithm family."
        },
        "x": {
          "$ref": "#/$defs/base64url",
          "description": "Base64url-encoded subtype-specific public-key octet string: 32 octets for Ed25519 or X25519, 57 for Ed448, and 56 for X448."
        },
        "d": {
          "$ref": "#/$defs/base64url",
          "description": "Base64url-encoded subtype-specific private-key octet string: 32 octets for Ed25519 or X25519, 57 for Ed448, and 56 for X448. For Ed25519 and Ed448, this is the RFC 8032 private seed, not an expanded or concatenated secret key. For X25519 and X448, it is the RFC 7748 scalar-input octet string."
        }
      },
      "required": ["kty", "crv", "x", "d"],
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "crv": {
              "type": "string",
              "const": "Ed25519"
            },
            "x": {
              "$ref": "#/$defs/octets32"
            },
            "d": {
              "$ref": "#/$defs/octets32"
            },
            "alg": {
              "type": "string",
              "const": "EdDSA"
            }
          },
          "allOf": [
            {
              "$ref": "#/$defs/signingMetadata"
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "crv": {
              "type": "string",
              "const": "Ed448"
            },
            "x": {
              "$ref": "#/$defs/octets57"
            },
            "d": {
              "$ref": "#/$defs/octets57"
            },
            "alg": {
              "type": "string",
              "const": "EdDSA"
            }
          },
          "allOf": [
            {
              "$ref": "#/$defs/signingMetadata"
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "crv": {
              "type": "string",
              "const": "X25519"
            },
            "x": {
              "$ref": "#/$defs/octets32"
            },
            "d": {
              "$ref": "#/$defs/octets32"
            },
            "alg": {
              "type": "string",
              "enum": [
                "ECDH-ES",
                "ECDH-ES+A128KW",
                "ECDH-ES+A192KW",
                "ECDH-ES+A256KW"
              ]
            }
          },
          "allOf": [
            {
              "$ref": "#/$defs/agreementMetadata"
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "crv": {
              "type": "string",
              "const": "X448"
            },
            "x": {
              "$ref": "#/$defs/octets56"
            },
            "d": {
              "$ref": "#/$defs/octets56"
            },
            "alg": {
              "type": "string",
              "enum": [
                "ECDH-ES",
                "ECDH-ES+A128KW",
                "ECDH-ES+A192KW",
                "ECDH-ES+A256KW"
              ]
            }
          },
          "allOf": [
            {
              "$ref": "#/$defs/agreementMetadata"
            }
          ]
        }
      ],
      "additionalProperties": true
    }
  }
}