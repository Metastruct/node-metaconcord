{
	"compilerOptions": {
		"paths": {
			"@/*": ["./*"]
		},
		"target": "es2022",
		"lib": ["es2022", "dom"],
		"module": "NodeNext",
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"allowSyntheticDefaultImports": true,
		"moduleResolution": "node16",
		"outDir": "./dist",
		"strictNullChecks": true,
		"skipLibCheck": true, // discord.js moment
		"noImplicitAny": false
	},
	"ts-node": {
		"transpileOnly": true,
		"files": true,
		"experimentalResolver": true,
		"esm": true
	}
}
